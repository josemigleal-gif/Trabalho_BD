DO $$
DECLARE
    i INT := 1;
BEGIN 
    WHILE i <= 100 LOOP
        INSERT INTO utilizador (id_utilizador, nome, e_mail, senha, data_registo, número_telemóvel)
        VALUES (
            i,
            'Utilizador_' || i,
            'utilizador_' || i || '@e_mail.com',
            'senha' || i,
            CURRENT_DATE,
            '91' || LPAD(i::text, 7, '0')
        );
        i := i + 1;
    END LOOP;
END;
$$;


DO $$
DECLARE
    i INT := 1;
    cidades TEXT[] := ARRAY[
        'Lisboa', 'Porto', 'Coimbra', 'Braga', 'Faro',
        'Aveiro', 'Leiria', 'Setúbal', 'Viseu', 'Évora'
    ];
    interesses_lista TEXT[] := ARRAY[
        'Tecnologia, Música',
        'Desporto, Viagens',
        'Cinema, Literatura',
        'Jogos, Ciência',
        'Arte, História',
        'Fotografia, Moda',
        'Culinária, Natureza',
        'Política, Economia',
        'Educação, Sustentabilidade',
        'Saúde, Bem-estar'
    ];
BEGIN
    WHILE i <= 100 LOOP
        INSERT INTO Perfil (
            id_utilizador,
            localização,
            idade,
            interesses,
            biografia,
            seguidores
        )
        VALUES (
            i,
            cidades[(i % array_length(cidades, 1)) + 1],
            18 + (i % 30),
            interesses_lista[(i % array_length(interesses_lista, 1)) + 1],
            'Sou o Utilizador_' || i || ' e adoro redes sociais!',
            1 + (i % 99)
        );
        i := i + 1;
    END LOOP;
END;
$$;

DO $$
DECLARE
    i INT := 1;
    privacidades TEXT[] := ARRAY['público', 'privado'];
BEGIN
    WHILE i <= 150 LOOP
        INSERT INTO publicação (
            id_publicação,
            id_utilizador,
            conteúdo,
            media,
            privacidade,
            data_da_publicação
        )
        VALUES (
            i,
            ((i - 1) % 100) + 1,  
            'Esta é a publicação número ' || i || ' do utilizador ' || ((i - 1) % 100) + 1,
            CASE WHEN i % 5 = 0 THEN 'imagem_' || i || '.jpg' ELSE NULL END,
            privacidades[(i % array_length(privacidades, 1)) + 1],
            CURRENT_TIMESTAMP - (i || ' minutes')::INTERVAL
        );
        i := i + 1;
    END LOOP;
END;
$$;


DO $$
DECLARE
    i INT := 1;
    emojis TEXT[] := ARRAY['😀', '🔥', '💯', '😢', '👏', '❤️', '😡', '👍', '👎', NULL];
BEGIN
    WHILE i <= 150 LOOP
        INSERT INTO Reação (
            id_reação,
            id_publicação,
            id_utilizador,
            gosto,
            data_reação,
            adoro,
            não_gosto,
            emoji
        )
        VALUES (
            i,
            ((i - 1) % 150) + 1,  -- Assume que tens 150 publicações
            ((i - 1) % 100) + 1,  -- Assume que tens 100 utilizadores
            (i % 3 = 1),          -- gosto: TRUE quando i mod 3 = 1
            CURRENT_TIMESTAMP - (i || ' minutes')::INTERVAL,
            (i % 3 = 0),          -- adoro: TRUE quando i mod 3 = 0
            (i % 3 = 2),          -- não_gosto: TRUE quando i mod 3 = 2
            emojis[(i % array_length(emojis, 1)) + 1]
        );
        i := i + 1;
    END LOOP;
END;
$$;



DO $$
DECLARE
    i INT := 1;
    nomes TEXT[] := ARRAY[
        'Exploradores Digitais', 'Cultura Pop', 'Gamers Unidos', 'Fotografia Urbana',
        'Café Filosófico', 'Cinema & Séries', 'Música Alternativa', 'Programadores PT',
        'Leitores Vorazes', 'Viajantes do Mundo'
    ];
BEGIN
    WHILE i <= 50 LOOP
        INSERT INTO Grupo (
            id_grupo,
            id_utilizador,
            nome,
            descrição,
            data_criação
        )
        VALUES (
            i,
            ((i - 1) % 50) + 1,  -- Assume que tens pelo menos 50 utilizadores
            nomes[(i % array_length(nomes, 1)) + 1],
            'Grupo dedicado a ' || nomes[(i % array_length(nomes, 1)) + 1],
            CURRENT_DATE - (i || ' days')::INTERVAL
        );
        i := i + 1;
    END LOOP;
END;
$$;




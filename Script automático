DO $$
DECLARE
    i INT := 1;
BEGIN 
    WHILE i <= 100 LOOP
        INSERT INTO utilizador (id_utilizador, nome, e_mail, senha, data_registo, número_telemóvel)
        VALUES (
            i,
            'Utilizador_' || i,
            'utilizador_' || i || '@e_mail.com',
            'senha' || i,
            CURRENT_DATE,
            '91' || LPAD(i::text, 7, '0')
        );
        i := i + 1;
    END LOOP;
END;
$$;


DO $$
DECLARE
    i INT := 1;
    cidades TEXT[] := ARRAY[
        'Lisboa', 'Porto', 'Coimbra', 'Braga', 'Faro',
        'Aveiro', 'Leiria', 'Setúbal', 'Viseu', 'Évora'
    ];
BEGIN
    WHILE i <= 100 LOOP
        INSERT INTO Perfil (
            id_utilizador,
            localização,
            idade,
            interesses,
            biografia,
            seguidores
        )
        VALUES (
            i,
            cidades[(i % array_length(cidades, 1)) + 1],  -- Escolhe cidade com base no índice
            18 + (i % 30),  -- Idades entre 18 e 47
            'Tecnologia, Música, Viagens',
            'Sou o Utilizador_' || i || ' e adoro redes sociais!',
            1 + (i % 99)     -- Seguidores entre 1 e 99
        );
        i := i + 1;
    END LOOP;
END;
$$;

CREATE OR REPLACE FUNCTION estatisticas_utilizador_completas(uid INT)
RETURNS TABLE (
    total_publicacoes BIGINT,
    total_comentarios BIGINT,
    total_mensagens_enviadas BIGINT,
    total_mensagens_recebidas BIGINT,
    total_reacoes BIGINT
) AS $$
BEGIN
    RETURN QUERY
    SELECT
        (SELECT COUNT(*) FROM publicação WHERE id_utilizador = uid),
        (SELECT COUNT(*) FROM Comentário WHERE id_utilizador = uid),
        (SELECT COUNT(*) FROM Mensagem WHERE id_remetente = uid),
        (SELECT COUNT(*) FROM Mensagem WHERE id_destinatário = uid),
        (SELECT COUNT(*) FROM Reação WHERE id_utilizador = uid);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION atividade_diaria_utilizador(uid INT, data_ref DATE)
RETURNS TABLE (
    publicacoes BIGINT,
    comentarios BIGINT,
    mensagens BIGINT,
    reacoes BIGINT
) AS $$
BEGIN
    RETURN QUERY
    SELECT
        (SELECT COUNT(*) FROM Publicação WHERE id_utilizador = uid AND DATE(data_da_publicação) = data_ref),
        (SELECT COUNT(*) FROM Comentário WHERE id_utilizador = uid AND DATE(data_comentário) = data_ref),
        (SELECT COUNT(*) FROM Mensagem WHERE id_remetente = uid AND DATE(data_envio) = data_ref),
        (SELECT COUNT(*) FROM Reação WHERE id_utilizador = uid AND DATE(data_reação) = data_ref);
END;
$$ LANGUAGE plpgsql;


SELECT * FROM atividade_diaria_utilizador(2, DATE '2025-11-03');




CREATE OR REPLACE FUNCTION publicidade_com_maior_alcance()
RETURNS TABLE (
    id_publicidade INT,
    titulo VARCHAR(50),
    alcance INT,
    id_utilizador INT
) AS $$
BEGIN
    RETURN QUERY
    SELECT p.id_publicidade, p.titulo, p.alcance, p.id_utilizador
    FROM Publicidade p
    ORDER BY p.alcance DESC
    LIMIT 1;
END;
$$ LANGUAGE plpgsql;



SELECT * FROM publicidade_com_maior_alcance();


CREATE OR REPLACE FUNCTION listar_relacoes_utilizador(uid INT)
RETURNS TABLE (
    id_relação INT,
    origem INT,
    destino INT,
    data_início TIMESTAMP,
    estado VARCHAR(100)
) AS $$
BEGIN
    RETURN QUERY
    SELECT r.id_relação, r.id_utilizador_origem, r.id_utilizador_destino, r.data_início, r.estado
    FROM Relação r
    WHERE r.id_utilizador_origem = uid OR r.id_utilizador_destino = uid;
END;
$$ LANGUAGE plpgsql;




SELECT * FROM listar_relacoes_utilizador(3);


CREATE OR REPLACE FUNCTION ler_comentarios(pid INT)
RETURNS TABLE (
    id_comentário INT,
    id_utilizador INT,
    conteúdo TEXT,
    data_comentário TIMESTAMP
) AS $$
BEGIN
    RETURN QUERY
    SELECT c.id_comentário, c.id_utilizador, c.conteúdo, c.data_comentário
    FROM Comentário c
    WHERE c.id_publicação = pid
    ORDER BY c.data_comentário DESC;
END;
$$ LANGUAGE plpgsql;



SELECT * FROM ler_comentarios(5);


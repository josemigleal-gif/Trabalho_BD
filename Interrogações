--1  Qual é o número total de reações por tipo (gosto, não_gosto, adoro)?
SELECT 
  SUM(CASE WHEN gosto THEN 1 ELSE 0 END) AS total_gostos,  
  SUM(CASE WHEN não_gosto THEN 1 ELSE 0 END) AS total_não_gostos, 
  SUM(CASE WHEN adoro THEN 1 ELSE 0 END) AS total_adoro 
FROM reação; 

--2 Quais são os nomes dos utilizadores com mais comentários feitos?
SELECT u.nome, stats.total_comentarios  
FROM Utilizador u 
JOIN (  
    SELECT c.id_utilizador, COUNT(*) AS total_comentarios  
    FROM Comentário c    
    GROUP BY c.id_utilizador 
) stats ON u.id_utilizador = stats.id_utilizador 
WHERE stats.total_comentarios = (
    SELECT MAX(conta)
    FROM (
        SELECT COUNT(*) AS conta
        FROM Comentário
        GROUP BY id_utilizador
    ) sub
);


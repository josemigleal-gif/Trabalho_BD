WITH relacoes_pendentes AS (
    SELECT id_utilizador_origem, id_utilizador_destino
    FROM Relação
    WHERE estado = 'pendente'
),
mensagens_para_pendentes AS (
    SELECT m.id_remetente, COUNT(*) AS total_mensagens
    FROM Mensagem m
    JOIN relacoes_pendentes r
      ON m.id_remetente = r.id_utilizador_origem
     AND m.id_destinatário = r.id_utilizador_destino
    GROUP BY m.id_remetente
),
contagem_relacoes AS (
    SELECT id_utilizador_origem, COUNT(*) AS total_relacoes
    FROM relacoes_pendentes
    GROUP BY id_utilizador_origem
)
SELECT u.id_utilizador, u.nome,
       COALESCE(cr.total_relacoes, 0) AS relacoes_pendentes,
       COALESCE(mp.total_mensagens, 0) AS mensagens_para_pendentes
FROM Utilizador u
LEFT JOIN contagem_relacoes cr ON u.id_utilizador = cr.id_utilizador_origem
LEFT JOIN mensagens_para_pendentes mp ON u.id_utilizador = mp.id_remetente;




--19
SELECT p.id_publicação, u.nome AS autor, 
       COALESCE(contagem.total_comentarios, 0) AS total_comentarios
FROM Publicação p
JOIN Utilizador u ON p.id_utilizador = u.id_utilizador
LEFT JOIN (
    SELECT id_publicação, COUNT(id_comentário) AS total_comentarios
    FROM Comentário
    GROUP BY id_publicação
) AS contagem ON p.id_publicação = contagem.id_publicação;




-- 20 Lista de todos os utilizadores e o número total de mensagens que enviaram.
SELECT u.id_utilizador, u.nome,
       COALESCE(m.total_mensagens, 0) AS total_mensagens_enviadas
FROM Utilizador u
LEFT JOIN (
    SELECT id_remetente, COUNT(*) AS total_mensagens
    FROM Mensagem
    GROUP BY id_remetente
) m ON u.id_utilizador = m.id_remetente;

SELECT DISTINCT m.id_remetente, u.nome
FROM Mensagem m
JOIN Utilizador u ON m.id_remetente = u.id_utilizador
WHERE NOT EXISTS (
    SELECT 1
    FROM Relação r
    WHERE r.estado = 'aceite'
      AND r.id_utilizador_origem = m.id_remetente
      AND r.id_utilizador_destino = m.id_destinatário
);

SELECT p.id_utilizador, u.nome
FROM Publicação p
JOIN Utilizador u ON p.id_utilizador = u.id_utilizador
GROUP BY p.id_utilizador, u.nome
HAVING SUM(CASE WHEN p.privacidade = 'privado' THEN 1 ELSE 0 END) >
       SUM(CASE WHEN p.privacidade = 'publico' THEN 1 ELSE 0 END);

SELECT u.id_utilizador, u.nome
FROM Utilizador u
WHERE u.id_utilizador IN (
    SELECT p.id_utilizador
    FROM Publicação p
    WHERE p.id_publicação NOT IN (
        SELECT r.id_publicação FROM Reação r
    )
);

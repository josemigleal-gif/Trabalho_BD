--4 Quais são os 5 pares de utilizadores que trocaram mais mensagens entre si? e quantas mensagens foram trocadas?
SELECT m.id_remetente, m.id_destinatário, COUNT(*) AS total_mensagens 
FROM Mensagem m 
GROUP BY m.id_remetente, m.id_destinatário
ORDER BY total_mensagens DESC 
LIMIT 5;

--5 Quais são os utilizadores que criaram publicidades com alcance superior à média geral?
SELECT u.nome, SUM(pu.alcance) AS alcance_total
FROM Utilizador u
JOIN Publicidade pu ON u.id_utilizador = pu.id_utilizador
GROUP BY u.nome
HAVING SUM(pu.alcance) > (
    SELECT AVG(alcance_total)
    FROM (
        SELECT SUM(alcance) AS alcance_total
        FROM Publicidade
        GROUP BY id_utilizador
    ) sub
);

--6 Quais são as publicações que receberam reações com emoji?
SELECT DISTINCT p.id_publicação, p.conteúdo
FROM Publicação p
JOIN Reação r ON p.id_publicação = r.id_publicação
WHERE r.emoji IS NOT NULL;

--7 Quais são os emojis mais usados nas reações?
SELECT emoji, COUNT(*) AS total
FROM Reação
WHERE emoji IS NOT NULL
GROUP BY emoji
ORDER BY total DESC;

--8 Quais são os utilizadores que enviaram mensagens para utilizadores com quem não têm relação?
SELECT DISTINCT m.id_remetente, u.nome
FROM Mensagem m
JOIN Utilizador u ON m.id_remetente = u.id_utilizador
WHERE NOT EXISTS (
    SELECT 1
    FROM Relação r
    WHERE r.estado = 'aceite'
      AND r.id_utilizador_origem = m.id_remetente
      AND r.id_utilizador_destino = m.id_destinatário
);

--9 Quais são os utilizadores que têm mais publicações privadas do que públicas?
SELECT p.id_utilizador, u.nome
FROM Publicação p
JOIN Utilizador u ON p.id_utilizador = u.id_utilizador
GROUP BY p.id_utilizador, u.nome
HAVING SUM(CASE WHEN p.privacidade = 'privado' THEN 1 ELSE 0 END) >
       SUM(CASE WHEN p.privacidade = 'publico' THEN 1 ELSE 0 END);

--10 Quais são os utilizadores que nunca receberam uma reação nas suas publicações?
SELECT u.id_utilizador, u.nome
FROM Utilizador u
WHERE EXISTS (
    SELECT 1
    FROM Publicação p
    WHERE p.id_utilizador = u.id_utilizador
)
AND NOT EXISTS (
    SELECT 1
    FROM Publicação p
    JOIN Reação r ON p.id_publicação = r.id_publicação
    WHERE p.id_utilizador = u.id_utilizador
);


--11 Quais são os utilizadores que têm mais publicações do que a média da plataforma?

SELECT u.id_utilizador, u.nome
FROM Utilizador u
WHERE (
    SELECT COUNT(*)
    FROM Publicação pub
    WHERE pub.id_utilizador = u.id_utilizador
) > (
    SELECT AVG(total_publicacoes)
    FROM (
        SELECT COUNT(*) AS total_publicacoes
        FROM Publicação
        GROUP BY id_utilizador
    ) AS estatisticas
);

--12 Quais são as publicações que receberam comentários de utilizadores que também reagiram com "não_gosto"?
SELECT p.id_publicação
FROM Publicação p
WHERE EXISTS (
    SELECT 1
    FROM Comentário c
    JOIN Reação r ON c.id_utilizador = r.id_utilizador
    WHERE c.id_publicação = p.id_publicação
      AND r.id_publicação = p.id_publicação
      AND r."não_gosto" = TRUE
);

--13 Qual é a proporção de publicações que nunca receberam comentários nem reações?
SELECT ROUND(COUNT(*) * 100.0 / (
    SELECT COUNT(*) FROM Publicação
), 2) AS percentagem_sem_interacao
FROM Publicação p
WHERE p.id_publicação NOT IN (
    SELECT id_publicação FROM Comentário
)
AND p.id_publicação NOT IN (
    SELECT id_publicação FROM Reação
);

--14 Qual é o tempo médio entre envio e visualização de mensagens que foram efetivamente vistas?
SELECT ROUND(AVG(EXTRACT(MINUTE FROM AGE(data_visualização, data_envio))), 2) AS tempo_medio_minutos
FROM Mensagem
WHERE data_visualização IS NOT NULL;

--15 Como é que se atualiza a biografia do perfil do utilizador com ID 7?
UPDATE Perfil
SET biografia = 'Apaixonado por música e viagens.'
WHERE id_utilizador = 7;

--16 Qual a média de comentários por publicação?
SELECT AVG(comentários_por_publicação) AS media_comentários
FROM (
  SELECT COUNT(*) AS comentários_por_publicação
  FROM Comentário
  GROUP BY id_publicação
) AS sub;

--17 Quais são os utilizadores que enviaram mensagens não visualizadas?
SELECT DISTINCT u.nome
FROM Utilizador u
JOIN Mensagem m ON u.id_utilizador = m.id_remetente
WHERE m.data_visualização IS NULL;

--18 Quais são os utilizadores com número de relações pendentes e quantas mensagens enviaram para esses mesmos utilizadores?
SELECT u.nome,
       COUNT(DISTINCT r.id_utilizador_destino) AS relacoes_pendentes,
       COUNT(DISTINCT m.id_mensagem) AS mensagens_para_pendentes
FROM Utilizador u
LEFT JOIN Relação r ON u.id_utilizador = r.id_utilizador_origem AND r.estado = 'pendente'
LEFT JOIN Mensagem m ON m.id_remetente = u.id_utilizador AND m.id_destinatário = r.id_utilizador_destino
GROUP BY u.nome;

--19 Cria uma lista de publicações com o respetivo autor e o número total de comentários recebidos.
SELECT p.id_publicação, u.nome AS autor,
       COUNT(c.id_comentário) AS total_comentarios
FROM publicação p
JOIN utilizador u ON p.id_utilizador = u.id_utilizador
LEFT JOIN comentário c ON p.id_publicação = c.id_publicação
GROUP BY p.id_publicação, u.nome;

--20 Lista de todos os utilizadores e o número total de mensagens que enviaram.
SELECT u.nome, COUNT(m.id_mensagem) AS total_mensagens_enviadas
FROM Utilizador u
LEFT JOIN Mensagem m ON u.id_utilizador = m.id_remetente
GROUP BY u.nome;

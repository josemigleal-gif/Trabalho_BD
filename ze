CREATE TABLE Utilizador (
    id_utilizador INT PRIMARY KEY,
    nome VARCHAR(70) NOT NULL,
    e_mail VARCHAR(100) UNIQUE NOT NULL,
    senha VARCHAR(70) NOT NULL,
    data_registo TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    número_telemóvel VARCHAR(15) UNIQUE NOT NULL
);

CREATE TABLE PERFIL (
    id_utilizor INT PRIMARY KEY,
    localização VARCHAR(200),
    idade INT,
    interesses TEXT,
    biografia TEXT,
    seguidores INT DEFAULT 0
);


CREATE TABLE Grupo (
    id_grupo INT PRIMARY KEY,
    id_utilizador INT NOT NULL,
    nome VARCHAR(50) NOT NULL,
    descrição TEXT,
    data_criação TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_utilizador) REFERENCES Utilizador(id_utilizador)
);

CREATE TABLE Publicação (
    id_publicação INT PRIMARY KEY,
    id_utilizador INT NOT NULL,
    conteúdo TEXT NOT NULL,
    media TEXT,
    privacidade VARCHAR(20) DEFAULT 'público' CHECK (privacidade IN ('público', 'privado')) NOT NULL,
    data_da_publicação TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_utilizador) REFERENCES Utilizador(id_utilizador)
); 

CREATE TABLE Comentário (
    id_comentário INT PRIMARY KEY,
    id_publicação INT NOT NULL,
    id_utilizador INT NOT NULL,
    conteúdo TEXT NOT NULL,
    data_comentário TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_publicação) REFERENCES Publicação(id_publicação),
    FOREIGN KEY (id_utilizador) REFERENCES Utilizador(id_utilizador)
);

CREATE TABLE Reação (
    id_reação INT PRIMARY KEY,
    id_publicação INT NOT NULL,
    id_utilizador INT NOT NULL,
    gosto BOOLEAN NOT NULL,
    data_reação TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    adoro BOOLEAN NOT NULL,
    não_gosto BOOLEAN NOT NULL,
    emoji VARCHAR(10),
    FOREIGN KEY (id_publicação) REFERENCES Publicação(id_publicação),
    FOREIGN KEY (id_utilizador) REFERENCES Utilizador(id_utilizador)
);

CREATE TABLE Mensagem (
    id_mensagem INT PRIMARY KEY,
    id_remetente INT NOT NULL,
    id_destinatário INT NOT NULL,
    data_envio TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    conteúdo TEXT NOT NULL,
    data_vizualização TIMESTAMP,
    FOREIGN KEY (id_remetente) REFERENCES Utilizador(id_utilizador),
    FOREIGN KEY (id_destinatário) REFERENCES Utilizador(id_utilizador)
);

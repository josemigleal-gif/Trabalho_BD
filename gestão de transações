--Um utilizador não pode existir no sistema sem um perfil associado. A transação garante que se a criação do perfil falhar, o utilizador não é criado (para não ficarem dados "órfãos").

CREATE OR REPLACE PROCEDURE registar_utilizador_completo(
    p_id INT,
    p_nome VARCHAR,
    p_email VARCHAR,
    p_senha VARCHAR,
    p_telemovel VARCHAR,
    p_localizacao VARCHAR
)
LANGUAGE plpgsql
AS $$
BEGIN
    INSERT INTO Utilizador (id_utilizador, nome, e_mail, senha, número_telemóvel)
    VALUES (p_id, p_nome, p_email, p_senha, p_telemovel);

    INSERT INTO PERFIL (id_utilizador, localização, seguidores)
    VALUES (p_id, p_localizacao, 0);

    COMMIT;
    
    RAISE NOTICE 'Utilizador e Perfil criados com sucesso.';

EXCEPTION
    WHEN OTHERS THEN
        RAISE NOTICE 'Erro na transação: %. A reverter alterações...', SQLERRM;
        ROLLBACK;
END;
$$;



--2 Alterar o estado de 'pendente' para 'aceite'. A transação deve garantir que o pedido realmente existe e ainda está pendente antes de o alterar.
CREATE OR REPLACE PROCEDURE aceitar_pedido_amizade(
    p_id_origem INT,
    p_id_destino INT
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_estado_atual VARCHAR;
BEGIN
    SELECT estado INTO v_estado_atual
    FROM Relação
    WHERE id_utilizador_origem = p_id_origem 
      AND id_utilizador_destino = p_id_destino;

    IF v_estado_atual IS NULL THEN
        RAISE NOTICE 'Pedido de amizade não encontrado. A cancelar...';
        ROLLBACK; 
        RETURN;
    ELSIF v_estado_atual = 'aceite' THEN
        RAISE NOTICE 'Esta relação já foi aceite anteriormente.';
        ROLLBACK;
        RETURN;
    ELSIF v_estado_atual != 'pendente' THEN
        RAISE NOTICE 'Estado inválido para aceitação.';
        ROLLBACK;
        RETURN;
    END IF;

    UPDATE Relação
    SET estado = 'aceite'
    WHERE id_utilizador_origem = p_id_origem 
      AND id_utilizador_destino = p_id_destino;

    COMMIT;
    RAISE NOTICE 'Amizade aceite com sucesso!';

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE NOTICE 'Erro ao processar o pedido: %', SQLERRM;
END;
$$;



--3 Cenário de Negócio: Um utilizador quer transformar uma das suas publicações normais numa Publicidade paga para ter mais alcance
CREATE OR REPLACE PROCEDURE promover_publicacao_anuncio(
    p_id_publicacao INT,
    p_titulo_campanha VARCHAR,
    p_alcance_pretendido INT
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_privacidade VARCHAR;
    v_media TEXT;
    v_id_dono INT;
    v_novo_id_anuncio INT;
BEGIN
    -- 1. Obter dados da publicação original (Bloqueando a linha para garantir consistência)
    SELECT privacidade, media, id_utilizador 
    INTO v_privacidade, v_media, v_id_dono
    FROM Publicação
    WHERE id_publicação = p_id_publicacao;

    -- 2. Validação 1: A publicação existe?
    IF NOT FOUND THEN
        RAISE NOTICE 'Publicação % não encontrada.', p_id_publicacao;
        ROLLBACK;
        RETURN;
    END IF;

    -- 3. Validação 2: Regra de Negócio - Apenas posts públicos podem ser anúncios
    IF v_privacidade = 'privado' THEN
        RAISE EXCEPTION 'Não é permitido promover publicações privadas.';
    END IF;

    -- 4. Validação 3: Regra de Negócio - O post tem de ter imagem para a publicidade
    IF v_media IS NULL OR v_media = '' THEN
        RAISE EXCEPTION 'A publicação não tem imagem/media para criar o anúncio.';
    END IF;

    -- 5. Gerar novo ID (visto que as tuas tabelas não têm SERIAL/AUTO_INCREMENT explícito)
    SELECT COALESCE(MAX(id_publicidade), 0) + 1 INTO v_novo_id_anuncio FROM publicidade;

    -- 6. Inserir na tabela de Publicidade (Transformação de dados)
    INSERT INTO publicidade (id_publicidade, id_utilizador, titulo, imagem_url, alcance)
    VALUES (v_novo_id_anuncio, v_id_dono, p_titulo_campanha, v_media, p_alcance_pretendido);

    -- 7. Confirmar a transação
    COMMIT;
    RAISE NOTICE 'Publicação promovida a anúncio com sucesso (ID Anúncio: %)', v_novo_id_anuncio;

EXCEPTION
    WHEN OTHERS THEN
        -- Em caso de erro (ex: violação de chave, dados inválidos), desfaz tudo
        RAISE NOTICE 'Falha na promoção: %', SQLERRM;
        ROLLBACK;
END;
$$;

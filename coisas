SELECT json_agg(doc) 
FROM (
    SELECT json_build_object(
        '_id', p.id_publicação,
        'data_publicacao', p.data_da_publicação,
        'conteudo', p.conteúdo,
        'media', p.media,
        'privacidade', p.privacidade,
        'autor', json_build_object(
            'id_sql', u.id_utilizador,
            'nome', u.nome
        ),
        'stats', json_build_object(
            'total_reacoes', (SELECT COUNT(*) FROM Reação r WHERE r.id_publicação = p.id_publicação),
            'total_comentarios', (SELECT COUNT(*) FROM Comentário c WHERE c.id_publicação = p.id_publicação)
        ),
        'reacoes_detalhe', COALESCE((
            SELECT json_agg(json_build_object(
                'user_id', r.id_utilizador,
                'tipo', CASE 
                    WHEN r.gosto IS TRUE THEN 'gosto'
                    WHEN r.adoro IS TRUE THEN 'adoro'
                    WHEN r.não_gosto IS TRUE THEN 'nao_gosto'
                    ELSE 'neutro'
                END,
                'emoji', r.emoji
            ))
            FROM Reação r
            WHERE r.id_publicação = p.id_publicação
        ), '[]'::json),
        'comentarios', COALESCE((
            SELECT json_agg(json_build_object(
                'user_id', c.id_utilizador,
                'nome_autor', cu.nome,
                'texto', c.conteúdo,
                'data', c.data_comentário
            ))
            FROM Comentário c
            JOIN Utilizador cu ON c.id_utilizador = cu.id_utilizador
            WHERE c.id_publicação = p.id_publicação
        ), '[]'::json)
    ) as doc
    FROM Publicação p
    JOIN Utilizador u ON p.id_utilizador = u.id_utilizador
) sub;





